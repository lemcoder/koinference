headers = koinference_whisper.h
# Without this, cinterop walks into the system headers our header includes and emits bridges for
# what it finds there: a ninth bridge for __DARWIN_NULL, generated on macOS, which then fails to
# compile against the NDK. It also means the bridge numbering could differ per platform, and that
# numbering is an ABI — see docs/backends.md.
headerFilter = koinference_whisper.h
package = koinference_whisper
