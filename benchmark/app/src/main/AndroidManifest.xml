<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:label="koinference"
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="koinference">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          One process per engine, and that is the point of this module rather than a detail of it.

          A model's memory is most of what anyone wants to measure, and in a shared process it
          arrives mixed with Compose, Ktor and whatever else the app is holding. Alone,
          `dumpsys meminfo` shows a line that is the model and its engine. It also means a native
          crash — a CPU without the instructions ggml was compiled for, say — takes down one engine
          instead of the app.

          android:process is fixed per manifest entry, which is why there is a service class per
          backend rather than one service told which engine to be.
        -->
        <service
            android:name=".service.LlamaCppService"
            android:exported="false"
            android:process=":llamacpp"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Benchmark inference engine, started from the app" />
        </service>

        <service
            android:name=".service.LiteRtLmService"
            android:exported="false"
            android:process=":litertlm"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Benchmark inference engine, started from the app" />
        </service>

        <service
            android:name=".service.CeraService"
            android:exported="false"
            android:process=":cera"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Benchmark inference engine, started from the app" />
        </service>

        <service
            android:name=".service.ExecuTorchService"
            android:exported="false"
            android:process=":executorch"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Benchmark inference engine, started from the app" />
        </service>

        <!--
          The benchmark, driven from a shell rather than a screen: same matrix, no tapping.

          exported, because being startable by `am start-foreground-service` is the entire point.
          It runs in the app process and binds the engine services, exactly as the UI does.
        -->
        <service
            android:name=".service.BenchmarkService"
            android:exported="true"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Benchmark run, started from a shell on a test device" />
        </service>

        <!--
          The HTTP server, in the app process rather than beside a model: it asks the engine process
          for that process's memory, so serving cannot contaminate the numbers it reports.

          exported, so a shell can start it without anyone tapping anything.
        -->
        <service
            android:name=".net.WebServerService"
            android:exported="true"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Benchmark inference server, started manually on a test device" />
        </service>
    </application>

</manifest>
